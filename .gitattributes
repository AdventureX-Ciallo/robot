# Line-ending rules: the Orange Pi 3B target is Linux, so shell scripts,
# Python, launch and systemd files must keep LF even on Windows checkouts.
*.sh        text eol=lf
*.py        text eol=lf
*.launch    text eol=lf
*.service   text eol=lf
*.xml       text eol=lf
CMakeLists.txt text eol=lf
*.md        text eol=lf
