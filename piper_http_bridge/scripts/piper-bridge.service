# systemd unit to auto-start the Piper ROS control node + HTTP/TCP bridge
# on the Orange Pi 3B at boot.
#
# Install:
#   sudo cp scripts/piper-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now piper-bridge.service
#
# Adjust the paths, user, CAN bring-up command and ROS distro to your setup.

[Unit]
Description=Piper 6-axis arm ROS control node + HTTP/TCP bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as your normal (non-root) user that owns the catkin workspace.
User=orangepi
Group=orangepi
# Bring the CAN interface up at 1 Mbps BEFORE starting ROS. The ExecStartPre
# below uses the official helper; point it at wherever can_activate.sh lives.
# If you activate CAN via another systemd unit or /etc/network/interfaces,
# delete this ExecStartPre line.
ExecStartPre=/bin/bash -c 'ip link show can0 >/dev/null 2>&1 || /usr/bin/env bash /home/orangepi/piper_ros/can_activate.sh can0 1000000 || true'
# Source ROS + the workspace, then launch both nodes.
ExecStart=/bin/bash -c 'source /opt/ros/noetic/setup.bash && source /home/orangepi/piper_ros/devel/setup.bash && roslaunch piper_http_bridge piper_http_bridge.launch can_port:=can0 auto_enable:=true'
Restart=on-failure
RestartSec=3
# Give CAN/hardware time after boot.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
